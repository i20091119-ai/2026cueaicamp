rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 행사 당일(2026-11-14)과 다음 날까지만 열어 둔다. 이후에는 자동으로 모두 막힌다.
    function open() { return request.time < timestamp.date(2026, 11, 16); }

    // 전화번호 숫자가 문서 ID라서 목록 조회(list)는 막고, 번호를 아는 사람만 한 건씩 읽게 한다.
    match /families/{key} {
      allow get, write: if open();
      allow list: if false;
    }
    match /booths/{id}  { allow read, write: if open(); }
    match /photos/{id}  { allow read, write: if open(); }
    match /votes/{id}   { allow read, write: if open(); }
    match /judge/{id}   { allow read, write: if open(); }
    match /config/{id}  { allow read, write: if open(); }
  }
}
